OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional server-only key. Enables the Supervisor's public web search worker.
# Search queries are sent to Tavily; never place this key in a frontend bundle.
TAVILY_API_KEY=
# Optional shared token for all /api/* requests. Use a random secret and restart the server.
INTERNAL_API_TOKEN=
# OpenAI-compatible endpoint; configured by the server administrator only.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional retrieval cutoff; calibrate with team documents.
RAG_MIN_SIMILARITY=0.45
# Optional LangSmith tracing. When true, questions, history, retrieved document text and answers are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tsukuyomi-for-unreal
# EU region or self-hosted: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Keep run structure and timing but drop inputs/outputs from traces.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
